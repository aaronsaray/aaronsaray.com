{
  "name": "aaronsaray.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "npm run lint:js && npm run lint:format && npm run lint:md",
    "lint:fix": "eslint . --fix && prettier --write . && markdownlint-cli2 --fix",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "verify": "astro check && astro build && node scripts/check-url-contract.mjs && node scripts/check-links.mjs && npm run lint && npm run test:e2e"
  },
  "volta": {
    "node": "24.20.0",
    "npm": "11.19.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.9",
    "hast-util-from-html": "2.0.3",
    "hastscript": "9.0.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
