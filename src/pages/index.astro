---
import Base from "../layouts/Base.astro";

// AI-GENERATED PLACEHOLDER: title and description. Aaron rewrites.
const title = "Engineering Coach, Developer, and CTO";
const description =
  "Aaron Saray coaches engineering managers and developers, builds software that stays simple, and leads as a CTO who puts communication first.";
---

<Base title={title} description={description} overlayHeader>
  {/* Landmark wrapper: every other page's template supplies <main>. */}
  <main id="main">
    <!-- ============ Hero: full viewport, left-aligned ============ -->
    <section class="relative flex min-h-svh flex-col justify-center">
      <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
        <!-- Reads as one sentence: Hi, I'm / Aaron Saray / I make things better. -->
        <!-- Arrow starts at the left margin and does the indenting itself.
           The arrow box width + gap is derived from the name's font
           size so "Hi" starts at the top-left corner of the A's flat
           apex at every viewport width. The corner is at 0.258em;
           0.245 compensates for the H's side bearing and the A's
           antialiased corner edge. Inside the box the chevron head
           overlaps the shaft (tip exactly on the shaft's end) and
           overflows 6px into the gap, so at narrow widths the head
           never pokes left of the margin. -->
        <p
          class="flex items-center text-[clamp(1.2rem,2.8vw,2.1rem)] leading-tight font-semibold text-ink-dim"
        >
          <span
            class="mr-2 flex w-[calc(0.245*clamp(3.5rem,9.5vw,8rem)-0.5rem)] shrink-0 items-center"
          >
            <span class="h-px flex-1 bg-ink-faint"></span>
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              class="-mr-1.5 -ml-[10px] size-4 shrink-0 text-ink-faint"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M9 6l6 6l-6 6"></path></svg
            >
          </span>Hi, I'm
        </p>
        <!-- Name sits just below the off-white ink token so it doesn't "bounce" -->
        <h1
          class="mt-2 text-[clamp(3.5rem,9.5vw,8rem)] leading-[0.95] font-black tracking-[-0.03em] text-[#dfe2e6]"
        >
          Aaron Saray
        </h1>
        <p
          class="mt-4 text-[clamp(1.55rem,4vw,3rem)] leading-tight font-bold tracking-[-0.01em] text-ink-dim"
        >
          I make things better.
        </p>
      </div>

      <!-- Whole cue is a link to the roles section. Deliberately no
         hover styling: only the cursor gives it away. -->
      <div class="absolute inset-x-0 bottom-8 flex justify-center">
        <a href="#how" class="flex flex-col items-center gap-2">
          <p class="text-base text-ink-mute sm:text-lg">let me show you how</p>
          <!-- Tabler: chevron-down -->
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            class="scroll-cue size-5 text-ink-faint"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 9l6 6l6 -6"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- ============ Roles ============ -->
    <!-- AI-GENERATED PLACEHOLDER COPY throughout this section: belief
       statements, paragraphs, and link text. Aaron rewrites. -->
    <section id="how" class="scroll-mt-20 border-t border-hairline">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <div
          class="grid grid-cols-1 gap-y-4 border-b border-hairline py-12 last:border-b-0 md:grid-cols-[1fr_2fr] md:gap-x-12"
        >
          <h2
            class="font-display text-2xl leading-snug font-semibold text-white sm:text-3xl"
          >
            As a coach
          </h2>
          <div class="role-copy">
            <p
              class="font-display text-2xl leading-snug font-semibold text-white"
            >
              Good teams are managed on purpose.
            </p>
            <p class="mt-5 max-w-prose leading-relaxed text-ink-dim">
              I coach engineering managers, and the developers who report to
              them. The pattern I run into most is a manager who has already
              decided what will not work: <a
                href="/2023/self-reflection-as-a-manager/"
                >&ldquo;we tried that before&rdquo;</a
              > is usually about the manager, not the idea.
            </p>
            <p class="mt-5 max-w-prose leading-relaxed text-ink-dim">
              Managing well means <a href="/2021/must-embrace-conflict/"
                >embracing conflict instead of smoothing it over</a
              >, <a href="/2020/developer-time-vs-manager-time/"
                >protecting the blocks of time developers need</a
              >, and letting people build the wrong thing first, because <a
                href="/2026/reinventing-the-wheel-is-how-you-learn/"
                >reinventing the wheel is how you learn</a
              >.
            </p>
          </div>
        </div>
        <div
          class="grid grid-cols-1 gap-y-4 border-b border-hairline py-12 last:border-b-0 md:grid-cols-[1fr_2fr] md:gap-x-12"
        >
          <h2
            class="font-display text-2xl leading-snug font-semibold text-white sm:text-3xl"
          >
            As a developer
          </h2>
          <div class="role-copy">
            <p
              class="font-display text-2xl leading-snug font-semibold text-white"
            >
              Simple, boring, and shipped beats clever.
            </p>
            <p class="mt-5 max-w-prose leading-relaxed text-ink-dim">
              I have written PHP for most of my career, and the longer I do it,
              the less code I want to keep. I <a
                href="/2023/an-argument-for-keeping-your-project-simple/"
                >argue against abstraction you have not earned</a
              >, <a href="/2022/deleting-vs-fixing-old-code/"
                >delete dead code on sight</a
              >, and treat automation as <a
                href="/2021/its-not-lazy-its-reducing-cognitive-load/"
                >reducing cognitive load, not laziness</a
              >.
            </p>
            <p class="mt-5 max-w-prose leading-relaxed text-ink-dim">
              New tools get a fair trial before they get a verdict, because <a
                href="/2019/have-informed-opinions/"
                >opinions should be informed</a
              >, and <a href="/2026/why-im-not-writing-about-ai-yet/"
                >AI is getting the same trial</a
              >.
            </p>
          </div>
        </div>
        <div
          class="grid grid-cols-1 gap-y-4 border-b border-hairline py-12 last:border-b-0 md:grid-cols-[1fr_2fr] md:gap-x-12"
        >
          <h2
            class="font-display text-2xl leading-snug font-semibold text-white sm:text-3xl"
          >
            As a CTO
          </h2>
          <div class="role-copy">
            <p
              class="font-display text-2xl leading-snug font-semibold text-white"
            >
              The real work is the bridge between the tech team and the rest of
              the C&#8209;suite.
            </p>
            <p class="mt-5 max-w-prose leading-relaxed text-ink-dim">
              Hands on code is about a fifth of the job. The rest is
              communication, guidance, priorities, and <a
                href="/2026/the-cto-is-a-communicator-first/"
                >laying out the consequence of every choice</a
              > so decision makers can decide with their eyes open.
            </p>
            <p class="mt-5 max-w-prose leading-relaxed text-ink-dim">
              For a business without a technical leader, that starts with <a
                href="/2021/what-non-it-startup-founders-need-to-know/"
                >what a non-technical founder needs to know</a
              >, <a href="/2025/what-type-of-contractor-are-you-hiring/"
                >which kind of contractor you are actually hiring</a
              >, and the oldest lesson on this site: <a
                href="/2011/solving-the-problem-not-the-solution/"
                >bring me the problem, not the solution</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Close ============ -->
    <!-- AI-GENERATED PLACEHOLDER COPY: headline, paragraph, and link
       text. Aaron rewrites. -->
    <!-- Bookends the hero: same heavy sans and off-white, one link, no box. -->
    <section class="border-t border-hairline">
      <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-36">
        <h2
          class="max-w-4xl text-[clamp(2rem,5.5vw,4.5rem)] leading-[1.02] font-black tracking-[-0.03em] text-[#dfe2e6]"
        >
          I want what's best for your project. Not for me.
        </h2>
        <p
          class="mt-8 max-w-prose text-lg leading-relaxed text-ink-dim sm:text-xl"
        >
          My opinions come from facts and from trial and error, and they change
          when the facts do. Bring me the problem and I'll tell you which of
          those three you need. If it's none of them, I'll say that too.
        </p>
        <a
          href="/contact/"
          class="mt-10 inline-flex items-center gap-3 text-lg font-semibold text-ink transition-colors duration-300 hover:text-white sm:text-xl"
        >
          Say hello
          <!-- Tabler: arrow-right -->
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path
              d="M13 6l6 6"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>
</Base>
