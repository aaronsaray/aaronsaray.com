---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

// Body prose is Aaron's, including its own leading H1.
const entry = await getEntry("pages", "contact");
if (!entry) throw new Error("pages/contact content missing");
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <div class="prose">
      <Content />
    </div>
  </main>
</Base>
