---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const title = "Contact";
const description = "Send me a note.";

// Entities through set:html: Astro escapes the & of a dynamic href.
// The hidden span hands tag-stripping harvesters a decoy host that
// takes no mail. It also splits the accessible name, so aria-label
// carries the address.
const encode = (text: string) =>
  [...text].map((char) => `&#${char.charCodeAt(0)};`).join("");
const user = "aaron";
const host = "aaronsaray.com";
const emailLink = `<a href="${encode(`mailto:${user}@${host}`)}" aria-label="${encode(`${user}@${host}`)}">${encode(`${user}@`)}<span class="hidden">mail.</span>${encode(host)}</a>`;
---

<Base title={title} description={description}>
  <main id="main" class="page-column">
    <h1 class="page-title">Send me a note.</h1>

    <div
      class="mt-10 grid grid-cols-1 gap-y-10 sm:mt-12 md:grid-cols-[3fr_2fr] md:items-start md:gap-x-12"
    >
      <div class="prose">
        <p>
          I will respond I promise. (I'm nice like that.) Plus, I practice
          inbox-zero - so I definitely will see it.
        </p>
        <p>
          I <strong>am</strong> accepting new contract work. Tell me about what
          you're building, or the challenges you have, and I'll tell you if I'm
          a fit.
        </p>
        <p>
          Or maybe you just want to say hi. Or tell me one of my blog entries is
          wrong and I'm "the worst" - I accept those emails, too!
        </p>
      </div>

      <div>
        <a
          href="https://meet.morebetterfaster.io"
          class="group link-card block p-5 sm:p-6"
        >
          <div class="flex items-center justify-between gap-4">
            <p class="subsection-title">Book a call</p>
            <Icon name="arrow-right" class="link-card-arrow" />
          </div>
          <p class="mt-1 text-sm text-ink-dim">via Google Calendar</p>
        </a>
        <hr class="mx-auto my-8 w-10 border-ink-faint" />
        <div class="prose">
          <p
            class="text-sm leading-relaxed text-ink-dim"
            set:html={`Rather email? ${emailLink}`}
          />
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          AI drafted email gets marked as spam. I'll accept your human words,
          gladly!
        </p>
      </div>
    </div>
  </main>
</Base>
