---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

// The body carries its own H1.
const entry = await getEntry("pages", "contact");
if (!entry) throw new Error("pages/contact content missing");
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <main id="main" class="page-column">
    <div class="prose">
      <Content />
    </div>
  </main>
</Base>
