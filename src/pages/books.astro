---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

// AI-GENERATED PLACEHOLDER: title and description

const books = await Promise.all(
  (await getCollection("books"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => {
      const { Content } = await render(entry);
      return { ...entry.data, Content };
    }),
);
---

<Base title="Books" description="Books written by Aaron Saray.">
  <main id="main" class="page-column">
    <h1 class="page-title">Books</h1>
    <section class="mt-4 divide-y divide-hairline">
      {
        books.map(({ Content, ...book }, i) => (
          <article class="group relative grid grid-cols-[6rem_1fr] gap-x-5 gap-y-1 py-10 first:pt-2 sm:grid-cols-[7rem_1fr] sm:grid-rows-[auto_1fr] sm:gap-x-8 sm:gap-y-0">
            <Image
              src={book.cover}
              alt=""
              width={224}
              densities={[1, 2]}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              class="block h-auto w-full border border-hairline transition-colors duration-300 group-hover:border-accent sm:row-span-2"
            />
            <h2 class="self-center section-title underline decoration-transparent decoration-2 underline-offset-4 transition-colors duration-300 group-hover:decoration-accent/60 sm:self-start">
              <a href={book.href} class="after:absolute after:inset-0">
                {book.title}
              </a>
            </h2>
            <div class="book-blurb entry-excerpt col-span-2 sm:col-span-1 sm:col-start-2">
              <Content />
            </div>
          </article>
        ))
      }
    </section>
  </main>
</Base>
