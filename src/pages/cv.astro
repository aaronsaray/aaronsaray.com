---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entry = await getEntry("pages", "cv");
if (!entry) throw new Error("pages/cv content missing");
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={entry.data.title} description={entry.data.description}>
  <main id="main" class="page-column lg:max-w-5xl">
    <h1 class="page-title">{entry.data.title}</h1>
    {entry.data.intro && <p class="page-lede">{entry.data.intro}</p>}
    <nav aria-label="Sections" class="mt-6 meta-line text-ink-dim">
      {
        sections.map((section, i) => (
          <>
            {i > 0 && <span aria-hidden="true">&middot;</span>}
            <a href={`#${section.slug}`} class="quiet-link">
              {section.text}
            </a>
          </>
        ))
      }
    </nav>
    <div class="prose cv">
      <Content />
    </div>
  </main>
</Base>
