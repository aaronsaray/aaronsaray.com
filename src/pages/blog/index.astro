---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import Pagination from "../../components/Pagination.astro";
import { getSortedPosts, pageCount, pageSlice } from "../../lib/posts";
import { SITE_DESCRIPTION } from "../../lib/site";

const posts = await getSortedPosts();
const total = pageCount(posts.length);
---

<Base title="Blog" description={SITE_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1
      class="font-display text-4xl leading-tight font-semibold text-white sm:text-5xl"
    >
      Blog
    </h1>
    <!-- AI-GENERATED PLACEHOLDER copy below (from the design
         prototype) — Aaron rewrites before launch. -->
    <p
      class="mt-4 border-b border-hairline pb-8 text-lg leading-relaxed text-ink-dim"
    >
      {posts.length} entries on programming, business, and management. Newest first.
      Looking for something meatier? <a
        href="/books/"
        class="text-ink underline decoration-accent/60 underline-offset-4 transition-colors duration-300 hover:text-white hover:decoration-accent"
        >Check out my books.</a
      >
    </p>

    <EntryList posts={pageSlice(posts, 1)} />
    <Pagination current={1} total={total} />
  </main>
</Base>
