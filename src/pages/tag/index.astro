---
import Base from '../../layouts/Base.astro';
import { getSortedPosts } from '../../lib/posts';
import { SITE_DESCRIPTION } from '../../lib/site';

const posts = await getSortedPosts();

// Term counts from post frontmatter, most-used first (Hugo's ByCount),
// term name breaking ties.
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const terms = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---
<Base title="Blog Tags" description={SITE_DESCRIPTION}>
  <main class="mx-auto max-w-3xl px-5 pb-24 pt-12 sm:px-8 sm:pt-16">
    <!-- Prose carried over from content/tag/_index.md (the H1 and the
         paragraph are Aaron's); the count is computed, replacing the
         Hugo blog-count shortcode. -->
    <h1 class="font-display text-4xl font-semibold leading-tight text-white sm:text-5xl">
      Tags for the Blog
    </h1>
    <p class="mt-4 border-b border-hairline pb-8 text-lg leading-relaxed text-ink-dim">
      My {posts.length} blog entries fall into these various different topics:
    </p>

    <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3">
      {terms.map(([term, count]) => (
        <a href={`/tag/${term}/`} class="group text-accent transition-colors duration-300 hover:text-[#7fa6c4]">
          #{term}
          <span class="text-sm text-ink-faint">({count})</span>
        </a>
      ))}
    </div>
  </main>
</Base>
