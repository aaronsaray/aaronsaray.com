---
import Icon from "../../../components/Icon.astro";
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import EntryList from "../../../components/EntryList.astro";
import { getSortedPosts } from "../../../lib/posts";
import { ogImageForTag } from "../../../lib/ogImage";

export async function getStaticPaths() {
  const tags = await getCollection("tags");
  return tags.map((entry) => ({
    params: { tag: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const term = entry.id;
const { Content } = await render(entry);

const posts = (await getSortedPosts()).filter((post) =>
  post.data.tags.includes(term),
);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImageForTag(term)}
>
  <main id="main" class="page-column">
    <h1 class="page-title">
      Entries with the tag &ldquo;{term}&rdquo;
    </h1>
    <div class="prose mt-6 border-b border-hairline pb-8">
      <Content />
    </div>

    <EntryList posts={posts} />

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-hairline pt-8 text-sm sm:flex-row"
    >
      <a
        href="/blog/"
        class="group -my-1.5 inline-flex items-center gap-2 py-1.5 text-ink-dim transition-colors duration-300 hover:text-ink"
      >
        <Icon
          name="arrow-left"
          class="size-4 text-ink-faint transition duration-300 group-hover:-translate-x-1 group-hover:text-accent"
        />
        Go to all posts
      </a>
      <a
        href={`/tag/${term}/index.xml`}
        class="-my-1.5 flex items-center gap-1.5 py-1.5 text-ink-dim transition-colors duration-300 hover:text-ink"
      >
        <Icon name="rss" class="size-3.5" />
        Get the RSS for {term}
      </a>
    </div>
  </main>
</Base>
