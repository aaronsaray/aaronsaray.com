---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import EntryList from "../../../components/EntryList.astro";
import { getSortedPosts } from "../../../lib/posts";
import { ogImageForTag } from "../../../lib/ogImage";

export async function getStaticPaths() {
  const tags = await getCollection("tags");
  return tags.map((entry) => ({
    params: { tag: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const term = entry.id;
const { Content } = await render(entry);

const posts = (await getSortedPosts()).filter((post) =>
  post.data.tags.includes(term),
);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImageForTag(term)}
>
  <main id="main" class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <!-- Hugo's tag pages carried a formulaic H1; the layout supplies
         it, the body below is Aaron's per-tag prose. -->
    <h1
      class="font-display text-4xl leading-tight font-semibold text-white sm:text-5xl"
    >
      Entries with the tag &ldquo;{term}&rdquo;
    </h1>
    <div class="prose mt-6 border-b border-hairline pb-8">
      <Content />
    </div>

    <EntryList posts={posts} />

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-hairline pt-8 text-sm sm:flex-row"
    >
      <a
        href="/blog/"
        class="group -my-1.5 inline-flex items-center gap-2 py-1.5 text-ink-dim transition-colors duration-300 hover:text-ink"
      >
        <!-- Tabler: arrow-left -->
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-4 text-ink-faint transition duration-300 group-hover:-translate-x-1 group-hover:text-accent/75"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12l14 0"></path><path d="M5 12l6 6"></path><path
            d="M5 12l6 -6"></path>
        </svg>
        Go to all posts
      </a>
      <a
        href={`/tag/${term}/index.xml`}
        class="-my-1.5 flex items-center gap-1.5 py-1.5 text-ink-dim opacity-80 transition-opacity duration-300 hover:opacity-100"
      >
        <!-- Tabler: rss -->
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path
            d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"
          ></path></svg
        >
        Get the RSS for {term}
      </a>
    </div>
  </main>
</Base>
