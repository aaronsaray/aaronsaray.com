---
import Base from "../layouts/Base.astro";

// The KERNAL power-on screen verbatim, spacing included. Its last blank
// row is the paragraph's pb-[1lh]: a trailing newline makes no line box.
const BANNER = [
  "",
  "    **** COMMODORE 64 BASIC V2 ****",
  "",
  " 64K RAM SYSTEM  38911 BASIC BYTES FREE",
].join("\n");
---

<Base title="Page Not Found" description="That page doesn't exist." noindex>
  <link
    slot="head"
    rel="preload"
    href="/fonts/C64_Pro_Mono-STYLE.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <main id="main" class="page-column">
    {
      /* 2.5cqw: C64 Pro Mono's cells are square, so 40 columns fill the
         container; 25lh is its 25 rows. The units sit on a child, not the
         @container div, or they resolve against the viewport. The rem
         floor keeps zoom growing the text once the column is narrower
         than 40 cells. */
    }
    <div class="border-[0.5rem] border-accent-dim bg-surface sm:border-[2rem]">
      <div class="@container">
        <div
          class="min-h-[25lh] font-c64 text-[max(0.7rem,2.5cqw)] leading-none text-accent"
        >
          <p
            aria-hidden="true"
            class="overflow-hidden pb-[1lh] whitespace-pre"
            set:text={BANNER}
          />
          <p>READY.</p>
          <p class="pb-[1lh]">LOAD"THAT PAGE",8</p>
          <p>SEARCHING FOR THAT PAGE</p>
          {/* Prettier collapses the double space in text. */}
          <h1 class="whitespace-pre">{"?FILE NOT FOUND  ERROR"}</h1>
          <p>READY.</p>
          <p>10 GOTO HOME</p>
          <p>
            <a
              id="run"
              href="/"
              class="-my-2 inline-block bg-clip-content py-2 transition-colors duration-300 hover:bg-accent hover:text-surface"
              >RUN<span class="sr-only">, go back home</span></a
            ><span
              aria-hidden="true"
              class="inline-block h-[1em] w-[1ch] animate-blink bg-current align-text-bottom motion-reduce:animate-none"
            ></span>
          </p>
        </div>
      </div>
    </div>
  </main>

  <script>
    // A focused control keeps Enter for itself.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" || e.repeat || e.target !== document.body) {
        return;
      }
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) {
        return;
      }
      document.getElementById("run")?.click();
    });
  </script>
</Base>
