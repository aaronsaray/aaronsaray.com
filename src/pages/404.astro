---
import Base from "../layouts/Base.astro";

// The stock KERNAL's power-on message, 40 columns: a blank first row,
// four spaces before the asterisks, one before 64K, a blank row
// between. The blank row after is the paragraph's bottom padding: a
// trailing newline makes no line box.
const BANNER = [
  "",
  "    **** COMMODORE 64 BASIC V2 ****",
  "",
  " 64K RAM SYSTEM  38911 BASIC BYTES FREE",
].join("\n");
---

<Base title="Page Not Found" description="That page doesn't exist.">
  <link
    slot="head"
    rel="preload"
    href="/fonts/C64_Pro_Mono-STYLE.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <main id="main" class="page-column">
    {
      /* The border is the VIC-II's; the container inside it is the
         picture area. C64 Pro Mono's cells are square, so 2.5cqw makes
         40 columns span the picture exactly and 25lh gives its 25 rows.
         Container units must not sit on the container itself (they
         would fall back to the viewport), and the rem floor is what
         lets browser zoom enlarge the text. */
    }
    <div class="border-[0.5rem] border-accent-dim bg-surface sm:border-[2rem]">
      <div class="@container">
        <div
          class="min-h-[25lh] overflow-hidden font-c64 text-[max(0.5rem,2.5cqw)] leading-none text-accent"
        >
          <p aria-hidden="true" class="pb-[1lh] whitespace-pre">{BANNER}</p>
          <p>READY.</p>
          {/* An expression: Prettier collapses the double space in text. */}
          <h1 class="whitespace-pre">{"?FILE NOT FOUND  ERROR"}</h1>
          <p>READY.</p>
          <p>10 GOTO HOME</p>
          <p>
            <a
              id="run"
              href="/"
              class="-my-2 inline-block py-2 transition-colors duration-300 hover:bg-accent hover:text-surface"
              >RUN<span class="sr-only">, go back home</span></a
            ><span
              aria-hidden="true"
              class="inline-block h-[1em] w-[1ch] animate-blink bg-ink align-text-bottom motion-reduce:animate-none"
            ></span>
          </p>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    // Enter anywhere on the page runs the program. A focused control
    // (a nav link, the menu buttons) keeps Enter for itself.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" || e.repeat || e.defaultPrevented) return;
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if (e.target.closest?.("a, button, input, select, textarea, [tabindex]"))
        return;
      document.getElementById("run").click();
    });
  </script>
</Base>
