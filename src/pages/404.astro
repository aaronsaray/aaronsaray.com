---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found" description="That page doesn't exist.">
  <main
    id="main"
    class="mx-auto flex max-w-3xl flex-col items-center px-5 pt-24 pb-24 text-center sm:px-8"
  >
    <p class="font-mono text-sm text-ink-mute">404</p>
    <h1
      class="mt-3 font-display text-4xl leading-tight font-semibold text-white sm:text-5xl"
    >
      Page not found
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-dim">
      That page doesn't exist (or doesn't anymore).
    </p>
    <div class="mt-10">
      <a
        href="/blog/"
        class="group -my-1.5 inline-flex items-center gap-2 py-1.5 text-sm text-ink-dim transition-colors duration-300 hover:text-ink"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-4 text-ink-faint transition duration-300 group-hover:-translate-x-1 group-hover:text-accent"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12l14 0"></path><path d="M5 12l6 6"></path><path
            d="M5 12l6 -6"></path>
        </svg>
        Go to all posts
      </a>
    </div>
  </main>
</Base>
