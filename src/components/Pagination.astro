---
interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
const newerHref = current === 2 ? "/blog/" : `/blog/page/${current - 1}/`;
const olderHref = `/blog/page/${current + 1}/`;
---

<nav
  class="flex items-center justify-between gap-4 border-t border-hairline pt-8 text-sm"
  aria-label="Pagination"
>
  {
    current > 1 ? (
      <a
        href={newerHref}
        class="group -my-1.5 inline-flex items-center gap-2 py-1.5 text-ink-dim transition-colors duration-300 hover:text-ink"
      >
        {/* Tabler: arrow-left */}
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-4 text-ink-faint transition duration-300 group-hover:-translate-x-1 group-hover:text-accent/75"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <>
            <path d="M5 12l14 0" />
            <path d="M5 12l6 6" />
            <path d="M5 12l6 -6" />
          </>
        </svg>
        Newer
      </a>
    ) : (
      <span />
    )
  }
  <span class="text-xs text-ink-mute">Page {current} of {total}</span>
  {
    current < total ? (
      <a
        href={olderHref}
        class="group -my-1.5 inline-flex items-center gap-2 py-1.5 text-ink-dim transition-colors duration-300 hover:text-ink"
      >
        Older
        {/* Tabler: arrow-right */}
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-4 text-ink-faint transition duration-300 group-hover:translate-x-1 group-hover:text-accent/75"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <>
            <path d="M5 12l14 0" />
            <path d="M13 18l6 -6" />
            <path d="M13 6l6 6" />
          </>
        </svg>
      </a>
    ) : (
      <span />
    )
  }
</nav>
