---
import Icon from "./Icon.astro";
import { isActive, type NavItem } from "../lib/nav";

interface Props {
  item: NavItem;
  nested?: boolean;
}
const { item, nested = false } = Astro.props;
const pathname = Astro.url.pathname;

const active = isActive(pathname, item);
// Exact match only: on a post, Blog is the active section but not the
// page being viewed.
const current = item.href === pathname ? "page" : undefined;
const tone = active ? "text-ink" : "text-ink-dim";
const rule = ["border-b", active ? "border-accent-dim" : "border-transparent"];

// py with negative my: 24px targets at the same visual height.
const bar =
  "-my-1.5 py-1.5 transition-colors text-shadow-[0_0_3px_var(--color-night),0_0_3px_var(--color-night),0_0_8px_var(--color-night)]";

const kind = nested ? "panel" : item.children ? "section" : "link";
const panelId = `nav-menu-${item.text.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
// Named, because a panel the hover script opens with showPopover()
// gets no implicit anchor from its button.
const anchor = `--${panelId}`;
---

{
  kind === "panel" && (
    <a
      href={item.href}
      aria-current={current}
      class:list={[
        "block px-4 py-1.5 transition-colors duration-300 hover:text-ink",
        tone,
      ]}
    >
      {item.text}
    </a>
  )
}

{
  kind === "link" && (
    <a
      href={item.href}
      aria-current={current}
      class:list={[bar, "inline-flex duration-300 hover:text-ink", tone]}
    >
      <span class:list={rule}>{item.text}</span>
    </a>
  )
}

{
  kind === "section" && (
    <div data-nav-section class="group">
      {/* show, not toggle: hover has opened the panel before a click
          lands, and a toggle would close it. */}
      <button
        type="button"
        popovertarget={panelId}
        popovertargetaction="show"
        style={`anchor-name: ${anchor}`}
        class:list={[
          bar,
          "flex items-center gap-1 duration-150 group-has-[:popover-open]:text-ink",
          tone,
        ]}
      >
        <span class:list={rule}>{item.text}</span>
        <Icon name="chevron-down" class="size-3.5" />
      </button>
      {/* pt-2, not a margin: the gap stays inside the section, so
          crossing it never ends the hover. */}
      <div
        id={panelId}
        popover
        style={`position-anchor: ${anchor}`}
        class="top-[anchor(bottom)] right-[anchor(right)] bottom-auto left-auto bg-transparent pt-2 opacity-0 transition-[opacity,display,overlay] transition-discrete duration-150 open:opacity-100 starting:open:opacity-0"
      >
        <div class="min-w-36 border border-hairline bg-surface py-2">
          {item.children!.map((child) => (
            <Astro.self item={child} nested />
          ))}
        </div>
      </div>
    </div>
  )
}

<script>
  // Hover is mouse-only: a touch pointer leaves when it lifts, which
  // would close the panel its tap just opened.
  document
    .querySelectorAll<HTMLElement>("[data-nav-section]")
    .forEach((section) => {
      const panel = section.querySelector<HTMLElement>("[popover]")!;
      let closing = 0;
      section.addEventListener("pointerenter", (e) => {
        if (e.pointerType !== "mouse") {
          return;
        }
        clearTimeout(closing);
        panel.showPopover();
      });
      section.addEventListener("pointerleave", (e) => {
        if (e.pointerType !== "mouse") {
          return;
        }
        // Grace for a mouse that slips off the edge.
        closing = window.setTimeout(() => panel.hidePopover(), 150);
      });
      section.addEventListener("focusout", (e) => {
        if (!section.contains(e.relatedTarget as Node | null)) {
          panel.hidePopover();
        }
      });
    });
</script>
