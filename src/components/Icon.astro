---
import { iconMarkup } from "../lib/icon.ts";

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const files = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { name, class: className, strokeWidth } = Astro.props;
const svg = files[`../icons/${name}.svg`];
---

<Fragment set:html={iconMarkup(svg, { class: className, strokeWidth })} />
