---
import { getPostCount } from "../lib/site";

const postCount = await getPostCount();
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-surface/40">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <!-- Two primary CTA boxes: the two main tasks -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <a
        href="/blog/"
        class="group border border-hairline p-6 transition-colors duration-300 hover:border-accent sm:p-8"
      >
        <div class="flex items-center justify-between">
          <h2 class="font-display text-xl font-semibold text-white sm:text-2xl">
            Read the blog
          </h2>
          <!-- Tabler: arrow-right, slides right on hover -->
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 text-ink-faint transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path
              d="M13 6l6 6"></path>
          </svg>
        </div>
        <!-- AI-GENERATED PLACEHOLDER COPY (from design prototype). Aaron rewrites -->
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          Two decades and {postCount} entries on programming, business, and management.
          The lessons stuck around; so did I.
        </p>
      </a>
      <a
        href="/contact/"
        class="group border border-hairline p-6 transition-colors duration-300 hover:border-accent sm:p-8"
      >
        <div class="flex items-center justify-between">
          <h2 class="font-display text-xl font-semibold text-white sm:text-2xl">
            Say hello
          </h2>
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 text-ink-faint transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path
              d="M13 6l6 6"></path>
          </svg>
        </div>
        <!-- AI-GENERATED PLACEHOLDER COPY (from design prototype). Aaron rewrites -->
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          Find out if we can work together, or just tell me your best
          production-outage story. I answer both.
        </p>
      </a>
    </div>

    <!-- Brand mark -->
    <div class="mt-14">
      <img
        src="/logo.svg"
        width="45"
        height="32"
        class="h-8 w-auto"
        alt="AS logo"
      />
    </div>

    <!-- Sitemap-style link columns -->
    <div class="mt-8 grid grid-cols-2 gap-8 text-sm sm:grid-cols-4">
      <div>
        <p
          class="text-xs font-semibold tracking-[0.2em] text-ink-mute uppercase"
        >
          Site
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <a
              href="/"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/who-am-i/"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Who am I</a
            >
          </li>
          <li>
            <a
              href="/cv/"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >CV</a
            >
          </li>
          <li>
            <a
              href="/blog/"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Blog</a
            >
          </li>
          <li>
            <a
              href="/books/"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Books</a
            >
          </li>
          <li>
            <a
              href="/contact/"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Contact</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p
          class="text-xs font-semibold tracking-[0.2em] text-ink-mute uppercase"
        >
          Find Me
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <a
              href="https://github.com/aaronsaray"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >GitHub</a
            >
          </li>
          <li>
            <a
              href="https://codepen.io/aaronsaray"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >CodePen</a
            >
          </li>
          <li>
            <a
              href="https://linkedin.com/in/aaronsaray"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >LinkedIn</a
            >
          </li>
          <li>
            <a
              href="https://twitter.com/aaronsaray"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Twitter</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p
          class="text-xs font-semibold tracking-[0.2em] text-ink-mute uppercase"
        >
          Projects
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <a
              href="https://show.nocompromises.io"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Laravel Podcast</a
            >
          </li>
          <li>
            <a
              href="https://learnthephoneticalphabet.com"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Learn the Phonetic Alphabet</a
            >
          </li>
          <li>
            <a
              href="https://typesetter.io"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Typesetter.io</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p
          class="text-xs font-semibold tracking-[0.2em] text-ink-mute uppercase"
        >
          Other Sites
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <a
              href="https://morebetterfaster.io"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >More Better Faster</a
            >
          </li>
          <li>
            <a
              href="https://masteringlaravel.io"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >Mastering Laravel</a
            >
          </li>
          <li>
            <a
              href="https://1lastcheck.com"
              class="-my-1 inline-block py-1 text-ink-dim transition-colors duration-300 hover:text-ink"
              >1lastcheck</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom meta row: legal left, feed right, same tier of info -->
    <div
      class="mt-14 flex items-center justify-between gap-4 border-t border-hairline pt-6 text-xs text-ink-mute"
    >
      <p>&copy; {year} Aaron Saray. Licensed under CC BY-SA 4.0.</p>
      <a
        href="/blog/index.xml"
        class="-my-1.5 flex items-center gap-1.5 py-1.5 transition-colors duration-300 hover:text-ink"
      >
        <!-- Tabler: rss -->
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path
            d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"
          ></path></svg
        >
        RSS
      </a>
    </div>
  </div>
</footer>
