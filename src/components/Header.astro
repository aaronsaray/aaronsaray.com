---
// The same bar on every page; on the homepage it overlays the hero.
interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class={overlay ? "absolute inset-x-0 top-0 z-10" : "relative z-10"}>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8"
  >
    <a href="/" aria-label="Aaron Saray home">
      <img src="/logo.svg" class="h-8 w-auto" alt="AS logo" />
    </a>
    <nav class="flex items-center gap-5 text-sm sm:gap-8">
      <div class="group relative">
        <button
          class="flex items-center gap-1 opacity-60 transition-opacity delay-300 duration-200 group-focus-within:opacity-100 group-focus-within:delay-0 group-hover:opacity-100 group-hover:delay-0"
        >
          About
          <!-- Tabler: chevron-down -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M6 9l6 6l6 -6"></path></svg
          >
        </button>
        <div
          class="invisible absolute top-full right-0 pt-2 opacity-0 transition-[opacity,visibility] delay-300 duration-200 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:delay-0 group-hover:visible group-hover:opacity-100 group-hover:delay-0"
        >
          <div class="min-w-36 border border-hairline bg-surface py-2">
            <a
              href="/who-am-i/"
              class="block px-4 py-1.5 opacity-70 transition-opacity duration-300 hover:opacity-100"
              >Who am I</a
            >
            <a
              href="/cv/"
              class="block px-4 py-1.5 opacity-70 transition-opacity duration-300 hover:opacity-100"
              >CV</a
            >
          </div>
        </div>
      </div>
      <div class="group relative">
        <button
          class="flex items-center gap-1 opacity-60 transition-opacity delay-300 duration-200 group-focus-within:opacity-100 group-focus-within:delay-0 group-hover:opacity-100 group-hover:delay-0"
        >
          Writing
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M6 9l6 6l6 -6"></path></svg
          >
        </button>
        <div
          class="invisible absolute top-full right-0 pt-2 opacity-0 transition-[opacity,visibility] delay-300 duration-200 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:delay-0 group-hover:visible group-hover:opacity-100 group-hover:delay-0"
        >
          <div class="min-w-36 border border-hairline bg-surface py-2">
            <a
              href="/blog/"
              class="block px-4 py-1.5 opacity-70 transition-opacity duration-300 hover:opacity-100"
              >Blog</a
            >
            <a
              href="/books/"
              class="block px-4 py-1.5 opacity-70 transition-opacity duration-300 hover:opacity-100"
              >Books</a
            >
          </div>
        </div>
      </div>
      <a
        href="/contact/"
        class="opacity-60 transition-opacity duration-300 hover:opacity-100"
        >Contact</a
      >
    </nav>
  </div>
</header>
