---
// The same bar on every page; fixed on the homepage so it overlays
// the hero instead of pushing it down.
import NavItem from "./NavItem.astro";
import { NAV } from "../lib/nav";

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class={`z-10 ${overlay ? "fixed inset-x-0 top-0" : "sticky top-0"}`}>
  {
    /* Progressive blur; the stack's mechanics are in global.css. It
       extends past the header's own height so the ramp finishes in open
       page rather than at the bar's edge, which is what removes the
       visible boundary. */
  }
  <div
    aria-hidden="true"
    class="progressive-blur pointer-events-none absolute inset-x-0 top-0 h-[150%]"
  >
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
  <!-- Skip link: first tab stop on every page, visible only while
       focused. Every template's <main> carries id="main". -->
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-hairline focus:bg-surface focus:px-4 focus:py-2 focus:text-ink"
  >
    Skip to content
  </a>
  <div
    class="relative mx-auto flex max-w-6xl items-center justify-between px-5 pt-6 pb-4 sm:px-8"
  >
    <a href="/" aria-label="Aaron Saray home">
      {
        /* Zero-offset black halo: nothing to see against the page, but
           it darkens blurred text passing under the mark. */
      }
      <img
        src="/logo.svg"
        width="45"
        height="32"
        class="h-8 w-auto drop-shadow-[0_0_6px_rgba(10,10,10,0.95)]"
        alt="AS logo"
      />
    </a>
    <nav class="flex items-center gap-5 text-sm sm:gap-8">
      {NAV.map((item) => <NavItem item={item} />)}
    </nav>
  </div>
</header>
