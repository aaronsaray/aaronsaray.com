---
// The same bar on every page; on the homepage it overlays the hero.
import NavDropdown from "./NavDropdown.astro";

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class={overlay ? "absolute inset-x-0 top-0 z-10" : "relative z-10"}>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8"
  >
    <a href="/" aria-label="Aaron Saray home">
      <img src="/logo.svg" class="h-8 w-auto" alt="AS logo" />
    </a>
    <nav class="flex items-center gap-5 text-sm sm:gap-8">
      <NavDropdown
        label="About"
        items={[
          { href: "/who-am-i/", text: "Who am I" },
          { href: "/cv/", text: "CV" },
        ]}
      />
      <NavDropdown
        label="Writing"
        items={[
          { href: "/blog/", text: "Blog" },
          { href: "/books/", text: "Books" },
        ]}
      />
      <a
        href="/contact/"
        class="opacity-60 transition-opacity duration-300 hover:opacity-100"
        >Contact</a
      >
    </nav>
  </div>
</header>
