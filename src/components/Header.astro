---
// The same bar on every page; on the homepage it overlays the hero.
import NavDropdown from "./NavDropdown.astro";

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class={overlay ? "absolute inset-x-0 top-0 z-10" : "relative z-10"}>
  <!-- Skip link: first tab stop on every page, visible only while
       focused. Every template's <main> carries id="main". -->
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-hairline focus:bg-surface focus:px-4 focus:py-2 focus:text-ink"
  >
    Skip to content
  </a>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8"
  >
    <a href="/" aria-label="Aaron Saray home">
      <img src="/logo.svg" class="h-8 w-auto" alt="AS logo" />
    </a>
    <nav class="flex items-center gap-5 text-sm sm:gap-8">
      <NavDropdown
        label="About"
        items={[
          { href: "/who-am-i/", text: "Who am I" },
          { href: "/cv/", text: "CV" },
        ]}
      />
      <NavDropdown
        label="Writing"
        items={[
          { href: "/blog/", text: "Blog" },
          { href: "/books/", text: "Books" },
        ]}
      />
      {
        /* py + negative my on the nav controls: 24px+ touch targets
          without changing the visual layout. */
      }
      <a
        href="/contact/"
        class="-my-1.5 py-1.5 opacity-60 transition-opacity duration-300 hover:opacity-100"
        >Contact</a
      >
    </nav>
  </div>
</header>
