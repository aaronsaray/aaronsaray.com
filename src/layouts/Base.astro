---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Konami from "../konami/Konami.astro";

interface Props {
  title: string;
  description: string;
  /** Site-absolute path, e.g. /images/tag/php.jpg */
  ogImage?: string;
  ogType?: "website" | "article";
  /** Frontmatter date string, passed through without Date coercion */
  publishedTime?: string;
  /** Drops the canonical and og:url along with adding the robots tag */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/images/og-image.png",
  ogType = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title} | Aaron Saray</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Aaron Saray" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="AaronSaray.com"
      href={new URL("/blog/index.xml", Astro.site)}
    />
    <slot name="head" />

    {/* crossorigin: fonts always fetch in CORS mode, even same-origin */}
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="flex min-h-svh flex-col bg-night font-sans text-ink antialiased">
    <Header />
    <div class="grow">
      <slot />
    </div>
    <Footer />
    <Konami />
  </body>
</html>
