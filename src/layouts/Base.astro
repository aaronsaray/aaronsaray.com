---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Site-absolute path, e.g. /images/tag/php.jpg */
  ogImage?: string;
  /** Homepage: header overlays the hero */
  overlayHeader?: boolean;
}

const {
  title,
  description,
  ogImage = "/images/og-image.png",
  overlayHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Aaron Saray</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="shortcut icon" href="/favicon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Aaron Saray" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:description" content={description} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="AaronSaray.com"
      href={new URL("/blog/index.xml", Astro.site)}
    />
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&family=Fraunces:opsz,wght@9..144,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-night font-sans text-ink antialiased">
    <Header overlay={overlayHeader} />
    <slot />
    <Footer />
  </body>
</html>
