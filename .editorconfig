# Prettier reads indent_style, indent_size and end_of_line as its options.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

# Two trailing spaces are a hard line break.
[*.md]
trim_trailing_whitespace = false

# Served verbatim.
[public/**]
trim_trailing_whitespace = false
insert_final_newline = false
