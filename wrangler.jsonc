{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aaronsaray-com",
  "compatibility_date": "2026-09-25",
  "routes": [{ "pattern": "aaronsaray.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Pairs with build.format "directory" in astro.config.ts: /path/
    // serves, /path answers 307 to /path/.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
