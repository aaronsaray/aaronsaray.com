# 'unsafe-inline' covers the style attributes Shiki, logo.svg, and
# NavItem.astro's anchor names emit.
/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'
  X-Content-Type-Options: nosniff

/.well-known/webfinger
  Content-Type: application/jrd+json

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro names everything here by content hash, so a changed file is a
# new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
