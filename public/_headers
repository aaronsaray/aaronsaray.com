# 'unsafe-inline' covers the style attributes Shiki, logo.svg, and
# NavItem.astro's anchor names emit. static.cloudflareinsights.com serves
# the beacon Cloudflare Web Analytics injects, at a versioned path, and
# the beacon reports to /cdn-cgi/rum under 'self'.
#
# A feature named in Permissions-Policy is off for the page and every
# frame in it. The YouTube embeds use fullscreen and the copy button on
# posts uses clipboard-write.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Browser-based fediverse clients fetch webfinger cross-origin.
/.well-known/webfinger
  Content-Type: application/jrd+json
  Access-Control-Allow-Origin: *

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro names everything here by content hash, so a changed file is a
# new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# A file under either path keeps its name when replaced, so a browser
# holding the old one shows it for up to 30 days, the max-age in seconds.
/uploads/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000
